# Copy to .env.local (never commit real values).

# PostgreSQL connection string. Server-side only — never exposed to the browser.
# Supabase: Project → Connect → "Transaction pooler" URI (port 6543).
DATABASE_URL=postgres://USER:PASSWORD@HOST:6543/postgres

# Random secret for signing sessions (at least 32 chars): openssl rand -base64 48
SESSION_SECRET=

# Shown in follow-up messages.
AGENCY_NAME=תכלת תיירות

# Optional. Leave empty to keep AI off (templates only, no cost).
# When set, a "שיפור ניסוח עם AI" button appears; each click is a paid Claude API call.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
